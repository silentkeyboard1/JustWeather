{
  "expo": {
    "name": "JustWeather",
    "slug": "JustWeather",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/JW_Icon.png",
    "scheme": "justweather",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon/JW_Icon.png",
      "bundleIdentifier": "duckintheyard.justweather"
    },
    "android": {
      "icon": "./assets/icon/JW_Icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F2",
        "foregroundImage": "./assets/icon/JW_Icon_Foreground.png",
        "monochromeImage": "./assets/icon/JW_Icon_Monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "duckintheyard.justweather",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon/JW_Icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F2",
          "image": "./assets/icon/JW_Splash.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JustWeather uses your location to show the current weather for your area.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CurrentWeather",
              "label": "JustWeather",
              "description": "Current weather and upcoming hours",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "521d79d5-2ecd-4c6c-998f-bc8765d2eeec"
      }
    }
  }
}
